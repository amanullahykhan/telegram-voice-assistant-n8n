    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH claimed AS (\n  UPDATE reminders\n  SET status = 'sending'\n  WHERE id IN (\n    SELECT id FROM reminders\n    WHERE status = 'pending' AND due_at <= now()\n    ORDER BY due_at ASC\n    LIMIT 50\n    FOR UPDATE SKIP LOCKED\n  )\n  RETURNING id, content, due_at, user_id\n)\nSELECT c.id, c.content, c.due_at, u.telegram_chat_id\nFROM claimed c\nJOIN users u ON u.id = c.user_id\nORDER BY c.due_at ASC;",
        "options": {}
      },
